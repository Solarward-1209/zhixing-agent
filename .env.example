# ============================================================
# 知行 Agent 环境变量模板
# 复制为 .env 后按需填写；未配置 AI_API_KEY 时自动运行本地演示模式。
# 部署平台请使用平台的环境变量注入，切勿把 .env 提交到仓库。
# ============================================================

# ===== 大模型接入（OpenAI 兼容协议）=====
# 提供商：zhipu（智谱）| deepseek | 自定义（配合 AI_BASE_URL / AI_MODEL）
AI_PROVIDER=zhipu
# 你的 API Key
AI_API_KEY=
# 可选：模型与网关地址
# AI_MODEL=glm-4-flash
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 可选：主模型整体失败后的降级模型
# AI_FALLBACK_MODEL=glm-4-flash
# 可选：单次请求超时（毫秒）与重试次数
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2

# ===== 图片理解（多模态，GLM-4V-Flash 有免费额度）=====
# VISION_API_KEY=
# VISION_MODEL=glm-4v-flash
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 向量检索（配置后 RAG 自动升级为 BM25 + 向量混合检索）=====
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 天气工具数据源 =====
# auto（默认，真实数据源 Open-Meteo，免 Key；演示模式回退离线样例）| real | mock
# WEATHER_MODE=auto

# ===== MCP（Model Context Protocol）工具集成 =====
# 声明后 Agent 会在启动/每 5 分钟内自动 tools/list 发现远端工具，并与内置工具一起参与 Function Calling。
# 多个 Server 用 JSON 数组；单个 Server 可用 MCP_SERVER_URL 简写。
# MCP_SERVERS=[{"name":"filesystem","url":"https://your-mcp-host/mcp","headers":{"Authorization":"Bearer xxx"}}]
# MCP_SERVER_URL=https://your-mcp-host/mcp
# MCP_SERVER_NAME=filesystem

# ===== 服务端限制（生产环境按需调整）=====
# PORT=8787
# MAX_BODY_BYTES=8388608
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
